import java.util.Scanner;

class  testQ2_1
{
	public static void main(String[] args) 
	{
		testQ2_1 obj = new testQ2_1();
		String str =  obj.Input("Enter text: ");
		String[] temp = str.split(" ");
		System.out.println(obj.firstCharToUpper(temp));
	}
	
	String Input(String UI){
		Scanner In= new Scanner(System.in);
		System.out.print(UI);
		return In.nextLine();
	}
	
	String firstCharToUpper(String[] temp){
		String text = "";
		for(int i=0;i<temp.length;i++){
			text = Character.toUpperCase(temp[i].charAt(0)) + temp[i].substring(1);
		}
		return text;
	}
}
